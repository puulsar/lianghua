# AQuant 部署环境变量
# 用法：复制本文件为同目录（仓库根）的 .env，按需修改。.env 已被 .gitignore 忽略。

# ---- 时区 ----
TZ=Asia/Shanghai

# ---- 数据库 ----
MYSQL_ROOT_PASSWORD=aquant_root_change_me
MYSQL_PASSWORD=testtest

# ---- 宿主机端口（飞牛自身占用 80/443/22，这里避开）----
# 主界面（Vue 应用）
WEB_PORT=8081
# 后端接口文档 + 内置管理 SPA（http://NAS_IP:8084/）
BACKEND_PORT=8084

# ---- 数据落盘位置 ----
# 默认落在仓库内 .runtime/docker（已 gitignore）。
# 想放到存储池就改成绝对路径，例如：
# DATA_ROOT=/vol1/1000/docker/aquant/data
DATA_ROOT=./.runtime/docker

# ---- JVM 内存（NAS 内存小于 4G 时把 -Xmx 调小）----
JAVA_OPTS="-Xms256m -Xmx1024m"

# ---- 邮件预警（可选；留占位符则不会真正发信）----
MAIL_HOST=smtp.qq.com
MAIL_USERNAME=your-email@qq.com
MAIL_PASSWORD=your-smtp-auth-code
